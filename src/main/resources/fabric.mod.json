{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Custom name formatting with MiniMessage. Visible to all FancyName users!",
  "authors": [ "yazilie" ],
  "contact": {
    "sources": "https://github.com/yazilie/FancyName",
    "issues": "https://github.com/yazilie/FancyName/issues",
    "homepage": "https://modrinth.com/mod/fancyname"
  },
  "license": "GPL-3.0",
  "icon": "assets/fancyname/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.yazilie.fancyname.FancyName"
    ],
    "modmenu": [
      "io.github.yazilie.fancyname.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "fancyname.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "adventure-platform-fabric": "*",
    "yet_another_config_lib_v3": "*"
  }
}
